<?xml version="1.0" encoding="utf-8"?>
<full-backup-content xmlns:tools="http://schemas.android.com/tools">
    <exclude
        domain="database"
        path="tblite.db" />
    <exclude
        domain="database"
        path="tblite.db-journal" />
    <exclude
        domain="database"
        path="tblite.db-wal" />
    <exclude
        domain="database"
        path="tblite.db-shm" />
    <exclude
        domain="sharedpref"
        path="crash.xml" />
    <exclude
        domain="file"
        path="error"
        tools:ignore="FullBackupContent" />
</full-backup-content>